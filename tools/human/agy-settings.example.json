{
  "permissions": {
    "allow": [
      "command(git add)",
      "command(git commit)",
      "command(git status)",
      "command(git diff)",
      "command(regex:^(npm (ci|run (build|test|lint))|pytest( .*)?|ruff check( .*)?|python -m pytest( .*)?)$)",
      "command(regex:^(cd web && )?node (--test|--experimental-strip-types) [A-Za-z0-9_./* -]+( && node (--test|--experimental-strip-types) [A-Za-z0-9_./* -]+)?$)",
      "command(regex:^(cd [A-Za-z0-9_./-]+ && )?(ls|cat|head|tail|wc|grep|rg|diff|tree|pwd|sed -n|git (log|show|status|diff|grep|ls-files))( [^;&|`$<>\\n~/ .][^;&|`$<>\\n~ ]*| \\.[^;&|`$<>\\n~ ./][^;&|`$<>\\n~ ]*| \\.)*$)",
      "command(regex:^(cd [A-Za-z0-9_./-]+ && )?([A-Za-z0-9_./-]*python3?|uv run) -m (pytest|py_compile)[^;&|`$<>\\n]*$)",
      "command(regex:^(cd [A-Za-z0-9_./-]+ && )?(npm (ci|test|run (build|test|lint))|npx (tsc|eslint|vitest|next lint)[^;&|`$<>\\n]*|node (--test|--experimental-strip-types) [^;&|`$<>\\n]*)$)"
    ],
    "deny": [
      "command(git push)",
      "command(regex:^git .*push)",
      "command(regex:^curl)",
      "command(regex:^rm -rf)"
    ]
  }
}
